# ============ 模型注册表 ============
# JSON 数组,每项描述一个模型。请求时用 "id" 字段选择模型。
# 模型文件路径相对于 modelservice/ 目录,也可写绝对路径。
MODELS_JSON_PATH=models.json

# ============ 推理参数默认值(每个模型可在 models.json 中覆盖) ============
N_CTX=4096            # 上下文窗口
N_THREADS=8           # CPU 线程数
N_GPU_LAYERS=0        # 卸载到 GPU 的层数;0=纯 CPU,-1=全部卸载
N_BATCH=512           # 批处理大小
USE_MMAP=true         # 是否使用内存映射
USE_MLOCK=false       # 是否锁定内存(避免 swap)

# ============ 默认多模态处理器(模型未指定时使用) ============
# 可选: qwen2.5vl | llava15 | llava16 | none
CHAT_HANDLER=qwen2.5vl

# ============ 单卡 VRAM 优化 ============
# 同一时刻只允许一个模型占用显存。请求新模型时,引用计数为 0 的其他模型会被
# 自动卸载,mmap 保留在 RAM 加速下次加载。
AUTO_EVICT=true

# ============ 服务配置 ============
HOST=0.0.0.0
PORT=8000
